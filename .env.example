# Copy this file to .env and fill in the values. Never commit .env.

# --- Flask ---
# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# 1 = auto-reload and debugger (local development only). Use 0 anywhere else.
FLASK_DEBUG=1

# --- Backend ---
# PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Leave empty to use a local SQLite file (instance/scheduler.db) instead.
DATABASE_URL=postgresql://scheduler:change-me@localhost:5432/scheduler
# Access code required to register a coordinator account. Share only with coordinators.
COORDINATOR_CODE=change-me
# Password for the demo accounts created by: flask --app run seed
DEMO_PASSWORD=password

# --- Frontend ---
# 1 when the app is served over HTTPS (sends the session cookie only over HTTPS).
SESSION_COOKIE_SECURE=0

# --- Local PostgreSQL server (for the team member who runs it; the app does not read these) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
# Run the tests against PostgreSQL (pytest reads this from the shell, not from .env):
#   PowerShell: $env:TEST_DATABASE_URL="postgresql://scheduler:change-me@localhost:5432/scheduler_test"; pytest
# TEST_DATABASE_URL=postgresql://scheduler:change-me@localhost:5432/scheduler_test
